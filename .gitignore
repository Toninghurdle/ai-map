.vercel/
*.tsbuildinfo
next-env.d.ts

# env: only .env.example is committed
.env
.env.*
!.env.example

# supabase local state (config.toml and migrations are committed)
supabase/.branches/
supabase/.temp/

# OS and editors
.DS_Store
.idea/
.vscode/*
