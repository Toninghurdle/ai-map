{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm seed:build)",
      "Bash(pnpm --filter:*)",
      "Bash(node scripts/seed/*)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)",
      "Bash(supabase db reset)",
      "Bash(supabase db diff:*)",
      "Bash(supabase migration new:*)",
      "Bash(supabase gen types:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(grep:*)",
      "Bash(npx playwright:*)"
    ],
    "ask": [
      "Bash(supabase db push:*)",
      "Bash(git push:*)",
      "Bash(vercel:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./apps/web/.env.local)",
      "Read(./.env.production)",
      "Bash(supabase db reset --linked:*)"
    ]
  }
}
